# Public branch-specific Auth endpoint only; no database credentials in mobile configuration.
EXPO_PUBLIC_NEON_AUTH_URL="https://your-development-branch.neonauth.neon.tech/neondb/auth"
# Actual Expo development server origin, registered on the development Auth branch.
# Replace LAN_IP with your Mac's Wi-Fi address; production requires its own HTTPS origin.
EXPO_PUBLIC_NEON_AUTH_ORIGIN="http://LAN_IP:8085"
# Public API location only. Development permits private-LAN HTTP; production requires HTTPS.
EXPO_PUBLIC_API_URL="http://LAN_IP:3001"
