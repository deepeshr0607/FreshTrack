# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Expo ──────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Native generated (Expo Continuous Native Generation) ──────────────────────
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Metro bundler ─────────────────────────────────────────────────────────────
.metro-health-check*

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Environment / secrets — NEVER commit these ────────────────────────────────
# .env.example IS committed (placeholder values only, no real secrets)
.env
.env.local
.env.*.local
# Release templates may be committed; actual root environment files must remain local.
.env.*
!.env.example
!.env.release.example
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production
backend/.env.staging
backend/.env.test

# ── Backend build output ──────────────────────────────────────────────────────
backend/dist/
backend/coverage/

# ── Prisma ────────────────────────────────────────────────────────────────────
# Generated client is rebuilt from `prisma generate` — don't commit it
backend/node_modules/.prisma/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# Vercel project links, pulled environment and local function bundles
.vercel/
# Placeholder-only backend preview template
!backend/.env.preview.example
