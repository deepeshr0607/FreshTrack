{
  "name": "freshtrack-api",
  "version": "1.0.0",
  "description": "FreshTrack Express API backend",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "node --env-file=.env scripts/database.cjs migrate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.cjs",
    "db:check": "npm run build && node --env-file=.env scripts/database.cjs check",
    "db:status": "node --env-file=.env scripts/database.cjs status",
    "test:database": "node --test tests/database-guard.test.cjs",
    "test:database:integration": "node --env-file=.env --test tests/database.integration.test.cjs",
    "test:seed:integration": "node --env-file=.env --test tests/seed.integration.test.cjs",
    "test:foundation": "npm run build && node --test tests/foundation.test.cjs",
    "test:households": "npm run build && node --test tests/households.test.mjs",
    "test:households:integration": "npm run build && node --env-file=.env --test tests/households.integration.test.cjs",
    "test:notification-retries:integration": "npm run build && node --env-file=.env --experimental-strip-types --test tests/notification-retries.integration.test.cjs",
    "db:studio": "prisma studio",
    "test:auth": "npm run build && node --test tests/auth.test.mjs",
    "build:vercel": "node scripts/deployment.cjs && prisma generate && tsc",
    "test:deployment": "npm run build && node --test tests/deployment.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^6.2.12",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true
  }
}
