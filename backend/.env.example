# Backend environment — copy to .env and fill in values
# Never commit .env — it is excluded by .gitignore

# ── Database ──────────────────────────────────────────────────────────────────
# Neon pooled connection for application requests (Prisma runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/freshtrack?sslmode=require&pgbouncer=true&connect_timeout=10"

# Neon direct (non-pooled) connection used by prisma migrate (migrations only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/freshtrack?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Neon Auth / Managed Better Auth base URL for the development branch
NEON_AUTH_URL="https://your-project.neon.tech/auth"

# ── Third-party APIs (server-side only — never in mobile code) ────────────────
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
# Prefer workload identity / Application Default Credentials in production.
# For local dev, point GOOGLE_APPLICATION_CREDENTIALS to a service-account key JSON.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

SPOONACULAR_API_KEY="your-spoonacular-api-key"

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS="http://localhost:8081,exp://localhost:8081"
