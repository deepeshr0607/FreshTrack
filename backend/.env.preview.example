# Vercel PREVIEW values only. Enter secrets in its environment settings, never Git/mobile.
# Set NODE_ENV explicitly for Preview; APP_ENV describes FreshTrack's data environment.
NODE_ENV=production
APP_ENV=preview
# VERCEL_ENV=preview is supplied by Vercel, not a user setting.
DATABASE_URL="postgresql://USER:PASSWORD@DEVELOPMENT_POOLER_HOST/neondb?sslmode=require&pgbouncer=true&connect_timeout=10&connection_limit=1&pool_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@DEVELOPMENT_DIRECT_HOST/neondb?sslmode=require"
NEON_AUTH_URL="https://DEVELOPMENT_AUTH_HOST/neondb/auth"
# 'none' permits native requests without Origin and rejects all browser origins.
# To enable a web client later, use its explicit HTTPS origin instead.
ALLOWED_ORIGINS="none"
# No Vision/Spoonacular credentials or fixture/migration consent flags needed here.
